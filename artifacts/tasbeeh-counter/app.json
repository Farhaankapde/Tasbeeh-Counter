{
  "expo": {
    "name": "Tasbeeh",
    "slug": "tasbeeh-counter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tasbeeh-counter",
    "userInterfaceStyle": "automatic",
    "ios": { "supportsTablet": true },
    "android": { "package": "com.farhaankapde.tasbeehcounter", "versionCode": 1, "adaptiveIcon": { "foregroundImage": "./assets/images/adaptive-icon-foreground.png", "backgroundColor": "#0B0B0B" } },
    "web": { "favicon": "./assets/images/icon.png" },
    "plugins": ["expo-router", ["expo-audio", { "recordAudioAndroid": false, "enableBackgroundPlayback": false }]],
    "experiments": { "typedRoutes": true, "reactCompiler": true }
  }
}
